{
  "name": "apex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive visualizations of how computers work: networking, cryptography, distributed systems, databases, algorithms and OS internals, simulated in the browser and tested against RFCs, test vectors and invariants.",
  "homepage": "https://apex.manishkhadka.info.np/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "demo": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "stats": "node scripts/stats.mjs",
    "stats:write": "node scripts/stats.mjs --write",
    "lint:slop": "node scripts/anti-slop.mjs",
    "verify:code": "node scripts/verify-code-examples.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "satori": "^0.63.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
